   ],
   "source": [
    "primes = []\n",
    "\n",
    "for num in range(2, 51):\n",
    "    # Check if number is prime\n",
    "    for i in range(2, int(num**0.5) + 1):\n",
    "        if num % i == 0:\n",
    "            break\n",
    "    else:\n",
    "        primes.append(num)\n",
    "\n",
    "# Print alternate primes\n",
    "alternate_primes = primes[::2]\n",
    "print(alternate_primes)"
   ]
