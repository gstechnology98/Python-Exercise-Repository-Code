    "<p style = \"font-size:20px; font-weight:bold;\">16. Write a program to check if a given number is a palindrome (reads the same forwards and backwards).</p>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "161680b1-a439-4be0-b5d1-c93789450b23",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "original number 121\n",
      "Yes. given number is palindrome number\n",
      "original number 125\n",
      "No. given number is not palindrome number\n"
     ]
    }
   ],
   "source": [
    "def check_palindrome(number):\n",
    "    print(\"original number\", number)\n",
    "    # Convert to string to reverse easily\n",
    "    original_str = str(number)\n",
    "    reversed_str = original_str[::-1]\n",
    "    \n",
    "    if original_str == reversed_str:\n",
    "        print(\"Yes. given number is palindrome number\")\n",
    "    else:\n",
    "        print(\"No. given number is not palindrome number\")\n",
    "\n",
    "check_palindrome(121)\n",
    "check_palindrome(125)"
   ]
  },
