      "2100 is not a leap year\n",
      "2018 is not a leap year\n"
     ]
    }
   ],
   "source": [
    "def is_leap(year):\n",
    "    # Standard Leap Year Logic\n",
    "    if (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0):\n",
    "        print(f\"{year} is a leap year\")\n",
    "    else:\n",
    "        print(f\"{year} is not a leap year\")\n",
    "\n",
    "is_leap(2024)\n",
    "is_leap(2100)\n",
    "is_leap(2018)"
   ]
