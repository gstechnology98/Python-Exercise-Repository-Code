    "<p style=\"font-size:20px;font-weight:bold;\">22. Write a function <b style=\"color:red;\">called exponent(base, exp)</b> that returns an integer value of the base raised to the power of the exponent.</p>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "6684a86d-7d3e-4146-8146-d4b058cc130d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2 raises to the power of 5 is: 32\n",
      "5 raises to the power of 4 is: 625\n"
     ]
    }
   ],
   "source": [
    "def exponent(base, exp):\n",
    "    num = exp\n",
    "    result = 1\n",
    "    # Repeat multiplication 'exp' times\n",
    "    while num > 0:\n",
    "        result = result * base\n",
    "        num = num - 1\n",
    "    print(base, \"raises to the power of\", exp, \"is:\", result)\n",
    "\n",
    "exponent(2, 5)\n",
    "exponent(5, 4)"
   ]
  },
