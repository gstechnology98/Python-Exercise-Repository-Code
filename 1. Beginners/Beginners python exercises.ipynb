    "<p style=\"font-size:20px; font-weight:bold;\">23. Write a program to check if a given number is a palindrome. A palindrome number remains the same when its digits are reversed (e.g., 121, 545).</p>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "552a3815-d013-49d8-acbd-b349b44b7ce2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original number 121\n",
      "Yes. given number is palindrome number\n",
      "Original number 127\n",
      "No. given number is not palindrome number\n"
     ]
    }
   ],
   "source": [
    "def check_palindrome_num(number):\n",
    "    # Convert to string to easily reverse\n",
    "    str_num = str(number)\n",
    "    reverse_str = str_num[::-1]\n",
    "    \n",
    "    if str_num == reverse_str:\n",
    "        print(f\"Original number {number}\")\n",
    "        print(\"Yes. given number is palindrome number\")\n",
    "    else:\n",
    "        print(f\"Original number {number}\")\n",
    "        print(\"No. given number is not palindrome number\")\n",
    "\n",
    "check_palindrome_num(121)\n",
    "check_palindrome_num(127)"
   ]
  },
