     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Given Number:  7536\n",
      "6 3 5 7 "
     ]
    }
   ],
   "source": [
    "number = 7536\n",
    "print(\"Given Number: \", number)\n",
    "\n",
    "while number > 0:\n",
    "    # Get the last digit\n",
    "    digit = number % 10\n",
    "    \n",
    "    # Remove the last digit from number\n",
    "    number = number // 10\n",
    "    \n",
    "    print(digit, end=\" \")"
   ]
