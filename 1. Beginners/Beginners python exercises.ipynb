    "<p style = \"font-size:20px; font-weight:bold;\">17. Create a new list from two given lists such that the new list contains odd numbers from the first list and even numbers from the second list.</p>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "f9f377c4-496b-42f6-8506-1a831428dbc7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "result list: [25, 35, 40, 60, 90]\n"
     ]
    }
   ],
   "source": [
    "def merge_list(list1, list2):\n",
    "    result_list = []\n",
    "    \n",
    "    # Get odd numbers from list1\n",
    "    for num in list1:\n",
    "        if num % 2 != 0:\n",
    "            result_list.append(num)\n",
    "            \n",
    "    # Get even numbers from list2\n",
    "    for num in list2:\n",
    "        if num % 2 == 0:\n",
    "            result_list.append(num)\n",
    "            \n",
    "    return result_list\n",
    "\n",
    "list1 = [10, 20, 25, 30, 35]\n",
    "list2 = [40, 45, 60, 75, 90]\n",
    "print(\"result list:\", merge_list(list1, list2))"
   ]
  },
